<?php
/* Registered under Menu="Buttons" so Unraid loads this page's assets into the <head> of every
   page: sheets/TowerTorch.Header.css (auto-injected because the basename matches this
   .page) restyles the main menu bar, and the script below loads the header enhancer.
   Link="tt-hdr-hook" makes Navigation render a bare <div> instead of a visible icon. All styling
   is gated behind html.tt-header-on, which the enhancer sets only when the main menu bar area
   is enabled in TowerTorch settings. */
?>
<!-- header.js loads deferred, so on its own the page would paint natively first and then snap to
     the TowerTorch look. This inline script stamps the same gating classes header.js apply() sets, read
     straight from localStorage, so the TowerTorch CSS applies from the first paint. It only adds classes,
     so a failure falls back to the flash rather than a blank page; apply() re-stamps them later. -->
<script>
(function () {
  try {
    var r = document.documentElement;
    function g(k, d) { try { var v = localStorage.getItem(k); return v == null ? d : v; } catch (e) { return d; } }
    var theming = g("tt.theming", "1") !== "0";
    var on = g("tt.enable.header", "0") !== "0" && theming;
    r.classList.toggle("tt-header-on", on);
    var shape = g("tt.badgeshape", "round");   // TTTheme.shapeName, the names from before GlimStone's shapes included
    r.setAttribute("data-tt-shape", shape === "soft" || shape === "rounded" ? "soft" : shape === "square" ? "square" : "round");
    var anim = g("tt.anim", "subtle");   // TTTheme.motionLevel, digits from before the names included
    r.setAttribute("data-tt-motion", anim === "off" || anim === "0" ? "off" : anim === "wild" || anim === "2" ? "wild" : "subtle");
    r.classList.toggle("tt-badge-glass", g("tt.badgeglass", "0") === "1" && theming);
    r.classList.toggle("tt-popups-on", theming);
    // OLED belongs to the screen, so it lives under a key the engine's mirror never syncs.
    if (g("towertorch.oled", "0") === "1" && theming) r.setAttribute("data-oled", ""); else r.removeAttribute("data-oled");
    r.classList.toggle("tt-footer-off", g("tt.footer", "1") === "1" && theming);
    r.classList.toggle("tt-hide-favtab", g("tt.hidefavtab", "0") === "1" && theming);
    r.classList.toggle("tt-usage-isl", on && g("tt.island", "1") !== "0");
    // The reactive rainbow classes use the same condition as apply(); without them every
    // reactive-mode badge shows its accent colour until the deferred header.js lands.
    var react = theming && g("tt.rbmode", "all") === "active";
    r.classList.toggle("tt-header-rbneutral", react && on);
    r.classList.toggle("tt-apps-rbneutral", react && /^\/Apps(\/|$)/.test(location.pathname));
    r.classList.toggle("tt-shares-rbneutral", react);
    r.classList.toggle("tt-settingsgrid-rbneutral", react);
  } catch (e) {}
})();
</script>
<script defer src="<?autov('/plugins/towertorch/scripts/header.js')?>"></script>
